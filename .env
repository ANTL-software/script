# API Configuration
VITE_API_BASE_URL=http://localhost:8800/api

# Application Configuration
VITE_APP_NAME=ANTL Script Vendeur
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=development

# =====================================================
# TÉLÉPHONIE - Configuration Twilio SIP
# =====================================================
# Pour utiliser Twilio au lieu de SignalWire/Asterisk:
# 1. Créez un SIP Domain dans Twilio Console
# 2. Créez des SIP Users pour chaque agent
# 3. Configurez les variables ci-dessous

# Twilio SIP Domain (ex: votre-domain.sip.us1.twilio.com)
VITE_TWILIO_SIP_DOMAIN=

# TURN Server (optionnel, pour traversée NAT avancée)
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Realm SIP (par défaut: domaine SIP de Twilio)
VITE_SIP_REALM=
