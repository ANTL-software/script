# API Configuration
VITE_API_BASE_URL=http://localhost:8800/api

# Application Configuration
VITE_APP_NAME=ANTL Script Vendeur
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=development

# =====================================================
# TELEPHONIE - Configuration Twilio SIP (Optionnel)
# =====================================================
# Configurez ces variables pour utiliser Twilio comme fournisseur SIP
# Si non configuré, le système utilisera SignalWire/Asterisk par défaut

# Twilio SIP Domain (ex: votre-domain.sip.us1.twilio.com)
# Utilisé pour l'authentification SIP et comme realm par défaut
VITE_TWILIO_SIP_DOMAIN=

# TURN Server (optionnel, pour traversée NAT avancée)
# Exemple: turn:votre-domain.sip.us1.twilio.com:3478
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Realm SIP (optionnel, par défaut: domaine SIP de Twilio)
# Pour SignalWire/Asterisk, utilisez: api.antl.fr
VITE_SIP_REALM=

# =====================================================
# NOTES:
# - Le STUN de Twilio (stun:global.stun.twilio.com:3478) est configuré par défaut
# - Les STUN de Google sont également utilisés comme fallback
# - Pour SignalWire, le STUN stun.signalwire.com:3478 est aussi configuré
# =====================================================
