# API Configuration
VITE_API_BASE_URL=http://localhost:8800/api

# Application Configuration
VITE_APP_NAME=ANTL Script Vendeur
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=development

# =====================================================
# TWILIO - VOICE SDK (Frontend Only)
# =====================================================
# Ces variables sont SÛRES pour le frontend
# (pas de secrets - tout est généré par le backend)

# Region (optionnel: us1, de1, ie1, au1, br1, sg1, jp1)
VITE_TWILIO_REGION=

# Edge Location (optionnel: dublin, roaming, sydney, etc.)
VITE_TWILIO_EDGE=

# Numéro Twilio pour affichage UI (optionnel)
VITE_TWILIO_PHONE_NUMBER=+33518251241
