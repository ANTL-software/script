# API Configuration
VITE_API_BASE_URL=http://localhost:8800/api

# Application Configuration
VITE_APP_NAME=ANTL Script Vendeur
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=development

# =====================================================
# TWILIO - VOICE SDK (Configuration Frontend)
# =====================================================
# Ces variables sont pour la configuration frontend uniquement
# Les secrets (Account SID, Auth Token) sont dans le BACKEND uniquement

# Region (optionnel: us1, de1, ie1, au1, br1, sg1, jp1)
VITE_TWILIO_REGION=

# Edge Location (optionnel: dublin, roaming, sydney, etc.)
VITE_TWILIO_EDGE=

# Numéro Twilio pour affichage (optionnel)
VITE_TWILIO_PHONE_NUMBER=+33518251241

# =====================================================
# SIP TRUNKING (Legacy - fallback)
# =====================================================
VITE_TWILIO_SIP_DOMAIN=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_SIP_REALM=
